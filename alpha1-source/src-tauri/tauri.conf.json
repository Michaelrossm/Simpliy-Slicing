{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Simpliy Slicing",
  "version": "0.0.0-alpha.1",
  "identifier": "dev.simpliy.slicing",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Simpliy Slicing",
        "width": 1540,
        "height": 920,
        "minWidth": 990,
        "minHeight": 640,
        "backgroundColor": "#242a30"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 Michael Roßmann",
    "publisher": "Michael Roßmann",
    "licenseFile": "../legal/LIZENZ.md"
  }
}
